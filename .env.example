APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# Local/demo seeder credentials. DatabaseSeeder skips these in production.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
TELESCOPE_ENABLED=true
TELESCOPE_LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

CATALOG_INTELLIGENCE_ENABLED=false
CATALOG_INTELLIGENCE_URL=http://localhost:8001
CATALOG_INTELLIGENCE_TOKEN=
CATALOG_INTELLIGENCE_APPLICATION_KEY=sisko-plan
CATALOG_INTELLIGENCE_CONNECT_TIMEOUT=1
CATALOG_INTELLIGENCE_TIMEOUT=4
CATALOG_INTELLIGENCE_DISCOVERY_TIMEOUT=35
CATALOG_INTELLIGENCE_MAX_IMAGES=3
SMART_SCANNER_AUTO_CAPTURE_ENABLED=true

# Set these to true for production after HTTPS and Platform Admin enrollment.
PLATFORM_ADMIN_2FA_REQUIRED=false
SECURITY_CSP_ENABLED=false
SECURITY_HSTS_ENABLED=false
STORE_WRITES_PER_MINUTE=90
PLATFORM_WRITES_PER_MINUTE=60
# Comma-separated proxy IPs/CIDRs supplied by the hosting platform. Never use * casually.
TRUSTED_PROXIES=
